#!/usr/bin/env bash
# Tear down only the verify-pit instance we started. Never kill by process name.
# Leaves evidence/ intact. Removes disposable DB and run state.
set -euo pipefail

SKILL="$(cd "$(dirname "$0")/.." && pwd)"
RUN_DIR="${VERIFY_PIT_RUN_DIR:-$SKILL/run}"
STATE="$RUN_DIR/state.env"

if [[ ! -f "$STATE" ]]; then
  echo "cleanup: nothing to do (no $STATE)"
  exit 0
fi
# shellcheck disable=SC1090
source "$STATE"

stop_tree() {
  local pgid="${VERIFY_PIT_PGID:-}"
  local pid="${VERIFY_PIT_PID:-}"
  if [[ -n "$pgid" ]]; then
    if kill -0 -- "-$pgid" 2>/dev/null || kill -0 "$pid" 2>/dev/null; then
      kill -- "-$pgid" 2>/dev/null || true
      sleep 0.6
      kill -9 -- "-$pgid" 2>/dev/null || true
      echo "cleanup: signaled process group -$pgid"
    else
      echo "cleanup: process group -$pgid already gone"
    fi
  elif [[ -n "$pid" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      # Fallback: walk children recorded at cleanup time
      local kids
      kids="$(pgrep -P "$pid" 2>/dev/null || true)"
      for k in $kids; do
        local grand
        grand="$(pgrep -P "$k" 2>/dev/null || true)"
        for g in $grand; do kill "$g" 2>/dev/null || true; done
        kill "$k" 2>/dev/null || true
      done
      kill "$pid" 2>/dev/null || true
      sleep 0.5
      for k in $kids; do kill -9 "$k" 2>/dev/null || true; done
      kill -9 "$pid" 2>/dev/null || true
      echo "cleanup: stopped pid $pid (and known children)"
    else
      echo "cleanup: pid $pid already gone"
    fi
  fi
}

stop_tree

# Remove disposable DB for this run only
if [[ -n "${VERIFY_PIT_DB_PATH:-}" ]]; then
  DB_DIR="$(dirname "$VERIFY_PIT_DB_PATH")"
  case "$DB_DIR" in
    "$RUN_DIR"/db-*)
      rm -rf "$DB_DIR"
      echo "cleanup: removed disposable db dir $DB_DIR"
      ;;
    *)
      echo "cleanup: refusing to delete unexpected db path $VERIFY_PIT_DB_PATH" >&2
      ;;
  esac
fi

rm -f "$STATE"
rm -f "${VERIFY_PIT_LOG:-}"
echo "cleanup: done (evidence/ preserved)"
